{
  "name": "relaywake",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "npm": ">=10.9.2 <12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:e2e": "vite build --mode e2e",
    "build:bundle": "vite build",
    "preview": "vite preview",
    "preview:e2e": "vite preview --mode e2e",
    "typecheck": "vue-tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build:e2e && npm run test:e2e:run",
    "test:e2e:run": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:production": "playwright test --config playwright.production.config.ts",
    "verify:production": "node scripts/verify-production-build.mjs",
    "check": "npm run typecheck && npm run test && npm run build:e2e && npm run test:e2e:run && npm run build && npm run verify:production && npm run test:production"
  },
  "dependencies": {
    "dexie": "^4.0.11",
    "phaser": "4.2.1",
    "pinia": "^3.0.3",
    "vue": "^3.5.18",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.0.0",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.11.1",
    "typescript": "~5.9.2",
    "vite": "^8.1.5",
    "vitest": "^4.0.0",
    "vue-tsc": "^3.3.8"
  }
}
