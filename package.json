{
  "name": "relaywake",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": "^26.13.0",
    "npm": "^11.12.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:itch": "vue-tsc -b && vite build --mode itch",
    "build:e2e": "vite build --mode e2e",
    "build:bundle": "vite build",
    "capture:itch": "npm run build:e2e && node scripts/capture-itch-assets.mjs",
    "package:itch": "npm run build:itch && node scripts/package-itch.mjs",
    "preview": "vite preview",
    "preview:e2e": "vite preview --mode e2e",
    "typecheck": "vue-tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build:e2e && npm run test:e2e:run",
    "test:e2e:run": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:production": "playwright test --config playwright.production.config.ts",
    "verify:itch": "node scripts/verify-itch-runtime.mjs",
    "verify:production": "node scripts/verify-production-build.mjs",
    "check": "npm run typecheck && npm run test && npm run build:e2e && npm run test:e2e:run && npm run build && npm run verify:production && npm run test:production"
  },
  "dependencies": {
    "dexie": "^4.0.11",
    "phaser": "4.2.1",
    "pinia": "^3.0.3",
    "vue": "^3.5.44",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.12",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^21.0.4",
    "typescript": "~5.9.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.8"
  }
}
